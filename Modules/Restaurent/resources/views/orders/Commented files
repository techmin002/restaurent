public function getOrder($id)
{
    $order = Order::with(['customer', 'items.menu'])->find($id);

    if (!$order) {
        return response()->json(['success' => false, 'message' => 'Order not found'], 404);
    }

   $items = $order->items->map(function($item) {
    $variation = $item->menuVariation; // make sure this relation exists in Item model
    return [
        'name' => $variation->menu->name ?? 'N/A', // menu name
        'variation' => $variation->name ?? 'N/A',  // variation name
        'qty' => $item->qty,                       // quantity
        'price' => $variation->price ?? 0,        // variation price
        'total' => $item->qty * ($variation->price ?? 0)
    ];
});

    $grand_total = $items->sum('total');
    $discount = $order->discount ?? 0;
    $net_payable = $grand_total - $discount;

    return response()->json([
        'id' => $order->id,
        'customer_name' => $order->customer->name ?? 'N/A',
        'items' => $items,
        'grand_total' => $grand_total,
        'discount' => $discount,
        'net_payable' => $net_payable
    ]);
}


