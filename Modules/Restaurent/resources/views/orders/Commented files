// ===== Serve -> Completed / Due =====
            document.querySelectorAll('.serveBtn').forEach(button => {
                button.addEventListener('click', () => {
                    const orderId = button.getAttribute('data-id');

                    // Get total amount from server
                    fetch(`/reception/get-total/${orderId}`, {
                            headers: {
                                "Accept": "application/json"
                            }
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (!data.success) return Swal.fire('Error',
                                'Failed to fetch total amount.', 'error');

                            const totalAmount = parseFloat(data.total) || 0;

                            Swal.fire({
                                title: 'Serve Order',
                                html: `
                        <p>Total Amount: <strong>Rs. ${totalAmount.toFixed(2)}</strong></p>
                        <label>Discount (Rs.):</label>
                        <input type="number" id="discountInput" class="swal2-input" min="0" placeholder="Enter discount">
                        <label>Paid Amount (Rs.):</label>
                        <input type="number" id="paidInput" class="swal2-input" min="0" placeholder="Enter amount paid"><br>
                        <p id="netAmountText">Net Amount: Rs. ${totalAmount.toFixed(2)} | Due: Rs. 0</p>
                    `,
                                showCancelButton: true,
                                confirmButtonText: 'Serve Order',
                                preConfirm: () => {
                                    const discount = parseFloat(document
                                        .getElementById('discountInput').value
                                    ) || 0;
                                    const paidAmount = parseFloat(document
                                        .getElementById('paidInput').value) || 0;
                                    if (discount > totalAmount) Swal
                                        .showValidationMessage(
                                            'Discount cannot exceed total amount');
                                    return {
                                        discount,
                                        paidAmount
                                    };
                                },
                                didOpen: () => {
                                    const discountInput = Swal.getPopup()
                                        .querySelector('#discountInput');
                                    const paidInput = Swal.getPopup().querySelector(
                                        '#paidInput');
                                    const netText = Swal.getPopup().querySelector(
                                        '#netAmountText');

                                    const updateNet = () => {
                                        const discountVal = parseFloat(
                                            discountInput.value) || 0;
                                        const paidVal = parseFloat(paidInput
                                            .value) || 0;
                                        const netTotal = totalAmount -
                                            discountVal;
                                        const due = netTotal - paidVal;
                                        netText.innerHTML =
                                            `Net Amount: Rs. ${netTotal.toFixed(2)} | Due: Rs. ${due > 0 ? due.toFixed(2) : 0}`;
                                    };

                                    discountInput.addEventListener('input',
                                        updateNet);
                                    paidInput.addEventListener('input', updateNet);
                                }
                            }).then(result => {
                                if (!result.isConfirmed) return;

                                const {
                                    discount,
                                    paidAmount
                                } = result.value;
                                const netTotal = totalAmount - discount;

                                // Serve order AJAX
                                fetch(`/reception/serve/${orderId}`, {
                                        method: "POST",
                                        headers: {
                                            "Content-Type": "application/json",
                                            "Accept": "application/json",
                                            "X-CSRF-TOKEN": csrfToken
                                        },
                                        body: JSON.stringify({
                                            discount,
                                            net_total: netTotal,
                                            paid_amount: paidAmount
                                        })
                                    })
                                    .then(res => res.json())
                                    .then(data => {
                                        if (data.success) {
                                            const statusText = data.status || (
                                                netTotal - paidAmount > 0 ?
                                                'Due' : 'Completed');
                                            updateButton(button, statusText);
                                            Swal.fire('Success',
                                                `Order marked as ${statusText}!`,
                                                'success');
                                        } else {
                                            Swal.fire('Error', data.message ||
                                                'Failed to process order.',
                                                'error');
                                        }
                                    })
                                    .catch(() => Swal.fire('Error',
                                        'Failed to connect to server.', 'error'));
                            });
                        })
                        .catch(() => Swal.fire('Error', 'Failed to connect to server.', 'error'));
                });
            });

